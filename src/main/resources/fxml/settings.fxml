<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.SettingsController"
      spacing="24"
      styleClass="screen-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="4">
        <Label text="Settings" styleClass="view-header"/>
        <Label text="Manage appearance, storage, and application preferences" styleClass="view-subtitle"/>
    </VBox>

    <!-- Section 1: Appearance -->
    <VBox spacing="12" styleClass="card">
        <Label text="Appearance" styleClass="card-title"/>
        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints prefWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Theme:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Default Light (Clean Slate)" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Font Family:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label text="System UI (BlinkMacSystemFont / Segoe UI / Roboto)" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Section 2: Database -->
    <VBox spacing="12" styleClass="card">
        <Label text="Database" styleClass="card-title"/>
        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints prefWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Database Driver:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="SQLite JDBC (org.xerial)" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Active JDBC URL:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblDatabaseUrl" text="jdbc:sqlite:mindmap.sqlite" styleClass="setting-value, code-badge" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Foreign Keys:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text="Enabled (PRAGMA foreign_keys = ON)" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </VBox>

    <!-- Section 3: Application -->
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Application" styleClass="card-title"/>
        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints prefWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Application Name:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="MindMap: Personal Knowledge Base &amp; Study Organizer" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Version:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblAppVersion" text="1.0-SNAPSHOT" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Phase:" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text="Phase 2 - UI Foundation &amp; Navigation" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </VBox>

</VBox>
