<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>

<ScrollPane fx:id="scrollSettings"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindmap.controller.SettingsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="inspector-scroll"
            stylesheets="@../css/style.css">

    <VBox spacing="20" styleClass="screen-container">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Header Section -->
        <VBox spacing="4">
            <Label text="Settings" styleClass="view-header"/>
            <Label text="Manage appearance, storage, and application preferences" styleClass="view-subtitle"/>
        </VBox>

        <!-- Section 1: Appearance -->
        <VBox spacing="14" styleClass="card">
            <Label text="APPEARANCE" styleClass="inspector-section-header"/>
            <GridPane hgap="24" vgap="14">
                <columnConstraints>
                    <ColumnConstraints prefWidth="180" minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Theme" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Default Academic Light" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Font Family" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="System UI / Inter" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

        <!-- Section 2: Data Management -->
        <VBox spacing="14" styleClass="card">
            <Label text="DATA MANAGEMENT" styleClass="inspector-section-header"/>
            <GridPane hgap="24" vgap="14">
                <columnConstraints>
                    <ColumnConstraints prefWidth="180" minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                
                <Label text="Export Data" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.valignment="CENTER"/>
                <Button text="Export to JSON..." onAction="#handleExport" styleClass="btn-secondary" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Import Data" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                <Button text="Import from JSON..." onAction="#handleImport" styleClass="btn-secondary" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Export Notes" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
                <Button text="Export to PDF..." onAction="#handleExportPdfAll" styleClass="btn-secondary" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>

        <!-- Section 3: Advanced Storage -->
        <VBox spacing="14" styleClass="card">
            <Label text="ADVANCED" styleClass="inspector-section-header"/>
            <GridPane hgap="24" vgap="14">
                <columnConstraints>
                    <ColumnConstraints prefWidth="180" minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Database Engine" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="SQLite JDBC" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Database File" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblDatabaseUrl" text="mindmap.sqlite" styleClass="code-badge" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Foreign Keys" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="Enabled" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>

        <!-- Section 4: Application -->
        <VBox spacing="14" styleClass="card">
            <Label text="APPLICATION" styleClass="inspector-section-header"/>
            <GridPane hgap="24" vgap="14">
                <columnConstraints>
                    <ColumnConstraints prefWidth="180" minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Application Name" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="MindMap" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Version" styleClass="setting-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblAppVersion" text="1.0.0" styleClass="setting-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

    </VBox>
</ScrollPane>
