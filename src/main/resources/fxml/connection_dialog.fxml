<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.ConnectionDialogController"
      spacing="16"
      prefWidth="520"
      prefHeight="460"
      styleClass="dialog-container"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <!-- Dialog Header -->
    <VBox spacing="4">
        <Label text="Connect Notes" styleClass="dialog-title"/>
        <Label text="Create a directional relationship between two study notes" styleClass="dialog-subtitle"/>
    </VBox>

    <!-- Source Note Field -->
    <VBox spacing="6">
        <Label text="From Note (Source) *" styleClass="form-label"/>
        <ComboBox fx:id="cmbSourceNote" promptText="Select source note..." maxWidth="Infinity" styleClass="modern-combo"/>
    </VBox>

    <!-- Target Note Field -->
    <VBox spacing="6">
        <Label text="To Note (Target) *" styleClass="form-label"/>
        <ComboBox fx:id="cmbTargetNote" promptText="Select target note..." maxWidth="Infinity" styleClass="modern-combo"/>
    </VBox>

    <!-- Relationship Field -->
    <VBox spacing="6">
        <Label text="Relationship Type" styleClass="form-label"/>
        <ComboBox fx:id="cmbRelation" promptText="Select or type relationship..." editable="true" maxWidth="Infinity" styleClass="modern-combo"/>
        <Label text="e.g., Related, Prerequisite, Example, Extension, Depends On" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Error Label -->
    <Label fx:id="lblError" text="" styleClass="error-label" wrapText="true"/>

    <!-- Action Buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel" cancelButton="true" styleClass="btn-secondary"/>
        <Button fx:id="btnConnect" text="Connect" onAction="#handleConnect" defaultButton="true" styleClass="btn-primary"/>
    </HBox>

</VBox>
