<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="scrollDashboard"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindmap.controller.DashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="inspector-scroll"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
            stylesheets="@../css/style.css">

    <VBox fx:id="contentContainer" spacing="20" styleClass="screen-container">
        <padding>
            <Insets top="24" right="28" bottom="28" left="28"/>
        </padding>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Header                                       -->
        <!-- ═══════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="140">
                <Label text="Dashboard" styleClass="view-header"/>
                <Label text="Your personal knowledge and learning overview" styleClass="view-subtitle" wrapText="true"/>
            </VBox>
            <FlowPane fx:id="paneHeaderButtons" hgap="8" vgap="6" alignment="CENTER_RIGHT" prefWrapLength="360" HBox.hgrow="NEVER">
                <Button fx:id="btnNewNote"      text="+ New Note"     onAction="#handleNewNote"      styleClass="btn-primary"/>
                <Button fx:id="btnStartReview"  text="Start Review"   onAction="#handleStartReview"  styleClass="btn-secondary"/>
                <Button fx:id="btnOpenMindMap"  text="Mind Map"       onAction="#handleOpenMindMap"  styleClass="btn-secondary"/>
                <Button fx:id="btnRefresh"      text="Refresh"        onAction="#handleRefresh"      styleClass="btn-secondary"/>
            </FlowPane>
        </HBox>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Row 1: 5 Metric Cards — always one row      -->
        <!-- ═══════════════════════════════════════════ -->
        <HBox fx:id="paneMetrics" spacing="14" alignment="CENTER_LEFT">

            <VBox fx:id="cardTotalNotes" spacing="4" styleClass="dashboard-metric-card" HBox.hgrow="ALWAYS">
                <Label text="TOTAL NOTES" styleClass="stat-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalNotes" text="0" styleClass="stat-value"/>
                    <Label text="notes saved" styleClass="stat-detail"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardTotalConnections" spacing="4" styleClass="dashboard-metric-card" HBox.hgrow="ALWAYS">
                <Label text="CONNECTIONS" styleClass="stat-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalConnections" text="0" styleClass="stat-value"/>
                    <Label text="relationships" styleClass="stat-detail"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardReviewsDue" spacing="4" styleClass="dashboard-metric-card" HBox.hgrow="ALWAYS">
                <Label text="DUE TODAY" styleClass="stat-label" style="-fx-text-fill: #dc2626;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblDueToday" text="0" styleClass="stat-value" style="-fx-text-fill: #dc2626;"/>
                    <Label text="need review" styleClass="stat-detail"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardUpcomingReviews" spacing="4" styleClass="dashboard-metric-card" HBox.hgrow="ALWAYS">
                <Label text="UPCOMING" styleClass="stat-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblUpcomingReviews" text="0" styleClass="stat-value"/>
                    <Label text="scheduled" styleClass="stat-detail"/>
                </HBox>
            </VBox>

            <VBox fx:id="cardTotalTags" spacing="4" styleClass="dashboard-metric-card" HBox.hgrow="ALWAYS">
                <Label text="TOTAL TAGS" styleClass="stat-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalTags" text="0" styleClass="stat-value"/>
                    <Label text="index tags" styleClass="stat-detail"/>
                </HBox>
            </VBox>

        </HBox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 2: Knowledge Distribution (full-width)                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <VBox fx:id="cardKnowledgeDistribution" spacing="10" styleClass="dashboard-card">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Knowledge Distribution" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Top subjects &amp; difficulty" styleClass="stat-detail"/>
            </HBox>

            <StackPane minHeight="190" prefHeight="200">
                <HBox fx:id="boxChartsContainer" spacing="20" alignment="CENTER">
                    <!-- BarChart: Notes by Subject -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="Notes by Subject" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <BarChart fx:id="chartSubjects" legendVisible="false" animated="false"
                                  prefHeight="170" VBox.vgrow="ALWAYS" styleClass="dashboard-chart">
                            <xAxis><CategoryAxis label="" animated="false"/></xAxis>
                            <yAxis><NumberAxis label="" animated="false" minorTickVisible="false" tickUnit="5"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- PieChart: Notes by Difficulty -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" maxWidth="280">
                        <Label text="Notes by Difficulty" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <PieChart fx:id="chartDifficulty" legendVisible="true" labelsVisible="false"
                                  animated="false" prefHeight="170" VBox.vgrow="ALWAYS" styleClass="dashboard-chart"/>
                    </VBox>
                </HBox>

                <!-- Empty state -->
                <VBox fx:id="boxEmptyCharts" alignment="CENTER" spacing="8" styleClass="placeholder-box"
                      visible="false" managed="false">
                    <Label text="No knowledge base data yet" styleClass="placeholder-heading"/>
                    <Label text="Create notes with subjects and difficulties to see distribution charts."
                           styleClass="placeholder-subtext" alignment="CENTER" wrapText="true"/>
                </VBox>
            </StackPane>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 3: Study &amp; Spaced Repetition | Knowledge Graph          -->
        <!--        (side-by-side inside one card)                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <HBox fx:id="paneMiddleSection" spacing="16" alignment="TOP_LEFT">

            <!-- Study & Spaced Repetition -->
            <VBox fx:id="cardRevisionOverview" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Study &amp; Spaced Repetition" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Go to Revision →" onAction="#handleStartReview" styleClass="btn-secondary"
                            style="-fx-font-size: 11px; -fx-padding: 3 10;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                        <Label text="COMPLETED TODAY" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        <Label fx:id="lblCompletedToday" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    </VBox>
                    <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                        <Label text="DUE TODAY" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <Label fx:id="lblRevisionDue" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                    </VBox>
                    <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                        <Label text="TOTAL ACTIVE" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                        <Label fx:id="lblTotalScheduled" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Today's Review Progress" style="-fx-font-size: 11px; -fx-font-weight: 500; -fx-text-fill: #475569;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblReviewProgressPercent" text="0%" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
                    </HBox>
                    <ProgressBar fx:id="progressReview" progress="0.0" maxWidth="Infinity" prefHeight="7" styleClass="dashboard-progress"/>
                    <Label fx:id="lblReviewProgressText" text="0 / 0 completed" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </VBox>
            </VBox>

            <!-- Knowledge Graph Structure -->
            <VBox spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Knowledge Graph Structure" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Knowledge Space →" onAction="#handleOpenMindMap" styleClass="btn-secondary"
                            style="-fx-font-size: 11px; -fx-padding: 3 10;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                        <Label text="CONNECTED NOTES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
                        <Label fx:id="lblConnectedNotes" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    </VBox>
                    <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                        <Label text="ISOLATED NOTES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <Label fx:id="lblIsolatedNotes" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    </VBox>
                </HBox>

                <Label fx:id="lblGraphRatio" text="0% of notes are linked by conceptual connections"
                       wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
            </VBox>

        </HBox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 4: Study Next | Favorites | Recently Viewed — equal thirds  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <HBox spacing="16" alignment="TOP_LEFT">

            <VBox fx:id="cardStudyNext" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Study Next" styleClass="card-title"/>
                </HBox>
                <VBox fx:id="boxStudyNext" spacing="6"/>
                <Label fx:id="lblEmptyStudy" text="No study recommendations available."
                       visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>

            <VBox fx:id="cardFavorites" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Favorites" styleClass="card-title"/>
                </HBox>
                <VBox fx:id="boxFavorites" spacing="6"/>
                <Label fx:id="lblEmptyFavorites" text="No favorite notes yet."
                       visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>

            <VBox fx:id="cardRecentlyViewed" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Recently Viewed" styleClass="card-title"/>
                </HBox>
                <VBox fx:id="boxRecentlyViewed" spacing="6"/>
                <Label fx:id="lblEmptyRecent" text="No recently viewed notes."
                       visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>

        </HBox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 5: Recent Learning Activity | Recently Updated Notes        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <HBox fx:id="paneLowerSection" spacing="16" alignment="TOP_LEFT">

            <VBox fx:id="cardRecentActivity" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Recent Learning Activity" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Full Timeline →" onAction="#handleOpenTimeline" styleClass="btn-secondary"
                            style="-fx-font-size: 11px; -fx-padding: 3 10;"/>
                </HBox>
                <VBox fx:id="boxRecentActivity" spacing="6"/>
                <VBox fx:id="boxEmptyActivity" alignment="CENTER" spacing="6" styleClass="placeholder-box"
                      style="-fx-padding: 24 16;" visible="false" managed="false">
                    <Label text="No recent activity recorded." styleClass="placeholder-heading"/>
                    <Label text="Study sessions and note updates will appear here." styleClass="placeholder-subtext"/>
                </VBox>
            </VBox>

            <VBox fx:id="cardRecentNotes" spacing="10" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Recently Updated Notes" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="All Notes →" onAction="#handleOpenNotes" styleClass="btn-secondary"
                            style="-fx-font-size: 11px; -fx-padding: 3 10;"/>
                </HBox>
                <VBox fx:id="boxRecentNotes" spacing="6"/>
                <VBox fx:id="boxEmptyNotes" alignment="CENTER" spacing="6" styleClass="placeholder-box"
                      style="-fx-padding: 24 16;" visible="false" managed="false">
                    <Label text="No notes found." styleClass="placeholder-heading"/>
                    <Label text="Create your first note to populate your knowledge base." styleClass="placeholder-subtext"/>
                </VBox>
            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
