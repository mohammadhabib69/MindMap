<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="scrollDashboard"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindmap.controller.DashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="inspector-scroll"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
            stylesheets="@../css/style.css">

    <VBox fx:id="contentContainer" spacing="20" styleClass="screen-container">
        <padding>
            <Insets top="20" right="24" bottom="24" left="24"/>
        </padding>

        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3" HBox.hgrow="ALWAYS" minWidth="140">
                <Label text="Dashboard" styleClass="view-header"/>
                <Label text="Your personal knowledge and learning overview" styleClass="view-subtitle" wrapText="true"/>
            </VBox>
            <FlowPane fx:id="paneHeaderButtons" hgap="8" vgap="6" alignment="CENTER_RIGHT" prefWrapLength="360" HBox.hgrow="NEVER">
                <Button fx:id="btnNewNote" text="+ New Note" onAction="#handleNewNote" styleClass="btn-primary" style="-fx-font-size: 12px; -fx-padding: 6 14;"/>
                <Button fx:id="btnStartReview" text="▶ Start Review" onAction="#handleStartReview" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 12;"/>
                <Button fx:id="btnOpenMindMap" text="🌐 Mind Map" onAction="#handleOpenMindMap" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 12;"/>
                <Button fx:id="btnRefresh" text="🔄 Refresh" onAction="#handleRefresh" styleClass="btn-secondary" style="-fx-font-size: 12px; -fx-padding: 6 10;"/>
            </FlowPane>
        </HBox>

        <!-- Primary Metrics Cards -->
        <FlowPane fx:id="paneMetrics" hgap="12" vgap="12" alignment="TOP_LEFT">
            <!-- Total Notes -->
            <VBox fx:id="cardTotalNotes" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="TOTAL NOTES" styleClass="inspector-section-header" style="-fx-text-fill: #2563eb;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalNotes" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="notes saved" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Total Connections -->
            <VBox fx:id="cardTotalConnections" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="CONNECTIONS" styleClass="inspector-section-header" style="-fx-text-fill: #8b5cf6;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalConnections" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="relationships" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Private Notes -->
            <VBox fx:id="cardPrivateNotes" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="PRIVATE NOTES" styleClass="inspector-section-header" style="-fx-text-fill: #ef4444;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblPrivateNotes" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="secured notes" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Reviews Due Today -->
            <VBox fx:id="cardReviewsDue" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="DUE TODAY" styleClass="inspector-section-header" style="-fx-text-fill: #dc2626;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblReviewsDue" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="need review" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Upcoming Reviews -->
            <VBox fx:id="cardUpcoming" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="UPCOMING" styleClass="inspector-section-header" style="-fx-text-fill: #0ea5e9;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblUpcoming" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="scheduled" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>

            <!-- Total Tags -->
            <VBox fx:id="cardTotalTags" spacing="4" styleClass="dashboard-metric-card" minWidth="130" prefWidth="155">
                <Label text="TOTAL TAGS" styleClass="inspector-section-header" style="-fx-text-fill: #10b981;"/>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="lblTotalTags" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="index tags" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>
            </VBox>
        </FlowPane>

        <!-- Middle Section: Knowledge Distribution & Revision/Graph Overview -->
        <FlowPane fx:id="paneMiddleSection" hgap="14" vgap="14" alignment="TOP_LEFT">
            <!-- Left Card: Knowledge Distribution -->
            <VBox fx:id="cardKnowledgeDistribution" spacing="12" styleClass="dashboard-card" minWidth="320" prefWidth="480">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Knowledge Distribution" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Top subjects &amp; difficulty" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>

                <!-- StackPane containing charts or empty state -->
                <StackPane minHeight="220" prefHeight="240">
                    <HBox fx:id="boxChartsContainer" spacing="12" alignment="CENTER">
                        <!-- BarChart: Subjects -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" minWidth="160">
                            <Label text="Notes by Subject" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <BarChart fx:id="chartSubjects" legendVisible="false" animated="false" prefHeight="200" minWidth="160" styleClass="dashboard-chart">
                                <xAxis>
                                    <CategoryAxis label="" animated="false"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="" animated="false" minorTickVisible="false" tickUnit="5"/>
                                </yAxis>
                            </BarChart>
                        </VBox>

                        <!-- PieChart: Difficulty -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER" minWidth="140">
                            <Label text="Notes by Difficulty" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <PieChart fx:id="chartDifficulty" legendVisible="true" labelsVisible="false" animated="false" prefHeight="200" minWidth="140" styleClass="dashboard-chart"/>
                        </VBox>
                    </HBox>

                    <!-- Empty State for Charts -->
                    <VBox fx:id="boxEmptyCharts" alignment="CENTER" spacing="8" styleClass="placeholder-box" visible="false" managed="false">
                        <Label text="📚" styleClass="placeholder-icon-small"/>
                        <Label text="No knowledge base data yet" styleClass="placeholder-heading"/>
                        <Label text="Create notes with subjects and difficulties to see distribution charts." styleClass="placeholder-subtext" alignment="CENTER" wrapText="true"/>
                    </VBox>
                </StackPane>
            </VBox>

            <!-- Right Card: Revision & Knowledge Graph Summaries -->
            <VBox fx:id="cardRevisionOverview" spacing="14" styleClass="dashboard-card" minWidth="300" prefWidth="420">
                <!-- Section 1: Study & Spaced Repetition Overview -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Study &amp; Spaced Repetition" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Go to Revision →" onAction="#handleStartReview" styleClass="btn-secondary" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                    </HBox>

                    <!-- Revision mini metrics -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                            <Label text="COMPLETED TODAY" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                            <Label fx:id="lblCompletedToday" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        </VBox>
                        <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                            <Label text="DUE TODAY" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                            <Label fx:id="lblRevisionDue" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        </VBox>
                        <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL ACTIVE" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                            <Label fx:id="lblTotalScheduled" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        </VBox>
                    </HBox>

                    <!-- Progress bar -->
                    <VBox spacing="4">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Today's Review Progress" style="-fx-font-size: 11px; -fx-font-weight: 500; -fx-text-fill: #475569;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblReviewProgressPercent" text="0%" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                        </HBox>
                        <ProgressBar fx:id="progressReview" progress="0.0" maxWidth="Infinity" prefHeight="8" styleClass="dashboard-progress"/>
                        <Label fx:id="lblReviewProgressText" text="0 / 0 completed" style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
                    </VBox>
                </VBox>

                <!-- Divider -->
                <Region style="-fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;"/>

                <!-- Section 2: Knowledge Graph Structure -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Knowledge Graph Structure" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Knowledge Space →" onAction="#handleOpenMindMap" styleClass="btn-secondary" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                            <Label text="CONNECTED NOTES" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
                            <Label fx:id="lblConnectedNotes" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        </VBox>
                        <VBox spacing="2" styleClass="revision-mini-stat" HBox.hgrow="ALWAYS">
                            <Label text="ISOLATED NOTES" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                            <Label fx:id="lblIsolatedNotes" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblGraphRatio" text="0% of notes are linked by conceptual connections" wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </VBox>
            </VBox>
        </FlowPane>

        <!-- Phase 18: Productivity Features Section -->
        <FlowPane fx:id="paneProductivitySection" hgap="14" vgap="14" alignment="TOP_LEFT">
            <!-- Study Next -->
            <VBox fx:id="cardStudyNext" spacing="10" styleClass="dashboard-card" minWidth="300" prefWidth="320">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Study Next" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox fx:id="boxStudyNext" spacing="6"/>
                <Label fx:id="lblEmptyStudy" text="No study recommendations available." visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>

            <!-- Favorites -->
            <VBox fx:id="cardFavorites" spacing="10" styleClass="dashboard-card" minWidth="300" prefWidth="320">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="★ Favorites" styleClass="card-title" style="-fx-text-fill: #eab308;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox fx:id="boxFavorites" spacing="6"/>
                <Label fx:id="lblEmptyFavorites" text="No favorite notes yet." visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>

            <!-- Recently Viewed -->
            <VBox fx:id="cardRecentlyViewed" spacing="10" styleClass="dashboard-card" minWidth="300" prefWidth="320">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Recently Viewed" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox fx:id="boxRecentlyViewed" spacing="6"/>
                <Label fx:id="lblEmptyRecent" text="No recently viewed notes." visible="false" managed="false" styleClass="placeholder-subtext"/>
            </VBox>
        </FlowPane>

        <!-- Lower Section: Recent Learning Activity & Recently Updated Notes -->
        <FlowPane fx:id="paneLowerSection" hgap="14" vgap="14" alignment="TOP_LEFT">
            <!-- Left: Recent Learning Activity -->
            <VBox fx:id="cardRecentActivity" spacing="10" styleClass="dashboard-card" minWidth="320" prefWidth="480">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Recent Learning Activity" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Full Timeline →" onAction="#handleOpenTimeline" styleClass="btn-secondary" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                </HBox>

                <!-- Activity List Container -->
                <VBox fx:id="boxRecentActivity" spacing="6">
                    <!-- Populated dynamically -->
                </VBox>

                <VBox fx:id="boxEmptyActivity" alignment="CENTER" spacing="6" styleClass="placeholder-box" style="-fx-padding: 24 16;" visible="false" managed="false">
                    <Label text="📅" styleClass="placeholder-icon-small"/>
                    <Label text="No recent activity recorded." styleClass="placeholder-heading"/>
                    <Label text="Study sessions and note updates will appear here." styleClass="placeholder-subtext"/>
                </VBox>
            </VBox>

            <!-- Right: Recently Updated Notes -->
            <VBox fx:id="cardRecentNotes" spacing="10" styleClass="dashboard-card" minWidth="300" prefWidth="420">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Recently Updated Notes" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="All Notes →" onAction="#handleOpenNotes" styleClass="btn-secondary" style="-fx-font-size: 10px; -fx-padding: 3 8;"/>
                </HBox>

                <!-- Notes List Container -->
                <VBox fx:id="boxRecentNotes" spacing="6">
                    <!-- Populated dynamically -->
                </VBox>

                <VBox fx:id="boxEmptyNotes" alignment="CENTER" spacing="6" styleClass="placeholder-box" style="-fx-padding: 24 16;" visible="false" managed="false">
                    <Label text="📝" styleClass="placeholder-icon-small"/>
                    <Label text="No notes found." styleClass="placeholder-heading"/>
                    <Label text="Create your first note to populate your knowledge base." styleClass="placeholder-subtext"/>
                </VBox>
            </VBox>
        </FlowPane>

    </VBox>
</ScrollPane>
