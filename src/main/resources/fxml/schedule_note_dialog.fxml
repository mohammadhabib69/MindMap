<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.ScheduleNoteDialogController"
      spacing="14"
      prefWidth="460"
      prefHeight="420"
      minWidth="360"
      minHeight="350"
      styleClass="review-dialog-root"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <VBox spacing="3">
        <Label text="Add Note to Revision" styleClass="view-header" style="-fx-font-size: 16px;"/>
        <Label text="Select a note from your knowledge base to schedule for spaced repetition." style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Search Input -->
    <TextField fx:id="txtSearchNote" promptText="🔍 Filter unscheduled notes..." styleClass="input-field" style="-fx-font-size: 12px;"/>

    <!-- Unscheduled Notes List -->
    <ListView fx:id="listUnscheduledNotes" VBox.vgrow="ALWAYS" styleClass="inspector-scroll" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px;"/>

    <!-- Bottom Action Bar -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button fx:id="btnSchedule" text="+ Add to Revision" onAction="#handleSchedule" styleClass="btn-primary" disable="true"/>
    </HBox>

</VBox>
