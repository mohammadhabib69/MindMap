<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizController"
      spacing="0" styleClass="screen-container" style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Quiz &amp; Exam Hub" styleClass="header-label" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;">
        <VBox.margin>
            <Insets bottom="15"/>
        </VBox.margin>
    </Label>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Question Bank">
            <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 15;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="comboFilterSubject" promptText="Subject"/>
                    <ComboBox fx:id="comboFilterTopic" promptText="Topic"/>
                    <ComboBox fx:id="comboFilterDifficulty" promptText="Difficulty"/>
                    <ComboBox fx:id="comboFilterType" promptText="Type"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnGenerateBank" text="+ Generate Questions" onAction="#handleGenerateBank" styleClass="btn-primary" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 4;"/>
                </HBox>
                <ListView fx:id="listQuestionBank" VBox.vgrow="ALWAYS" style="-fx-background-insets: 0;"/>
            </VBox>
        </Tab>
        <Tab text="Exam">
            <VBox alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 20;">
                <VBox spacing="15" maxWidth="500" styleClass="card" style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
                    <Label text="Configure your Exam" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Subject" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamSubject" maxWidth="Infinity"/>
                    
                    <Label text="Topic" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamTopic" maxWidth="Infinity"/>
                    
                    <Label text="Difficulty" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamDifficulty" maxWidth="Infinity"/>
                    
                    <Label text="Count" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamCount" maxWidth="Infinity"/>
                    
                    <Label text="Mode" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamMode" maxWidth="Infinity"/>
                    
                    <Label text="Time Limit" style="-fx-text-fill: #475569;"/>
                    <ComboBox fx:id="comboExamTime" maxWidth="Infinity"/>
                    
                    <Label fx:id="lblAvailableBankCount" text="0 questions available" style="-fx-text-fill: #64748b;"/>
                    
                    <Button fx:id="btnStartExam" text="Start Exam" onAction="#handleStartExam" maxWidth="Infinity" styleClass="btn-primary" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-padding: 10; -fx-font-weight: bold; -fx-background-radius: 4;"/>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
