<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizController"
      spacing="0" styleClass="screen-container"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="24" right="32" bottom="32" left="32"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label text="Quiz &amp; Exam" styleClass="view-header"/>
            <Label text="Study from your saved notes and test your knowledge" styleClass="view-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Segmented Control (Tabs) -->
        <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 3;">
            <Button fx:id="btnTabBank" text="Question Bank" onAction="#handleTabBank" styleClass="segment-btn, segment-active" style="-fx-background-radius: 6; -fx-padding: 6 18;"/>
            <Button fx:id="btnTabExam" text="Take Exam" onAction="#handleTabExam" styleClass="segment-btn" style="-fx-background-radius: 6; -fx-padding: 6 18;"/>
        </HBox>
    </HBox>

    <Region prefHeight="24" minHeight="24"/>

    <!-- Main Content Area uses a StackPane to hold both views so they take full space -->
    <StackPane VBox.vgrow="ALWAYS" alignment="TOP_LEFT" minHeight="0" minWidth="0">
        
        <!-- QUESTION BANK VIEW -->
        <VBox fx:id="boxQuestionBank" spacing="16" VBox.vgrow="ALWAYS" minHeight="0">
            
            <!-- Statistics Bar -->
            <HBox spacing="14" minWidth="0">
                <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0" styleClass="dashboard-metric-card">
                    <Label text="QUESTIONS" styleClass="stat-label"/>
                    <Label fx:id="lblStatQuestions" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0" styleClass="dashboard-metric-card">
                    <Label text="TOPICS" styleClass="stat-label"/>
                    <Label fx:id="lblStatTopics" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0" styleClass="dashboard-metric-card">
                    <Label text="SUBJECTS" styleClass="stat-label"/>
                    <Label fx:id="lblStatSubjects" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0" styleClass="dashboard-metric-card">
                    <Label text="EXAMS TAKEN" styleClass="stat-label"/>
                    <Label fx:id="lblStatExams" text="0" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <VBox spacing="12" VBox.vgrow="ALWAYS" minHeight="0">
                <HBox spacing="10" alignment="CENTER_LEFT" minWidth="0">
                    <TextField fx:id="txtSearchBank" promptText="Search questions..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
                    <ComboBox fx:id="comboFilterSubject" promptText="Subject" styleClass="modern-combo"/>
                    <ComboBox fx:id="comboFilterTopic" promptText="Topic" styleClass="modern-combo"/>
                    <ComboBox fx:id="comboFilterDifficulty" promptText="Difficulty" styleClass="modern-combo"/>
                    <ComboBox fx:id="comboFilterType" promptText="Type" styleClass="modern-combo"/>
                    <Button fx:id="btnGenerateBank" text="+ Generate Questions" onAction="#handleGenerateBank" styleClass="btn-primary"/>
                </HBox>
                <ListView fx:id="listQuestionBank" VBox.vgrow="ALWAYS" minHeight="0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;"/>
            </VBox>
        </VBox>

        <!-- EXAM SETUP VIEW -->
        <VBox fx:id="boxExamSetup" spacing="24" visible="false" managed="false" alignment="TOP_CENTER" style="-fx-padding: 16 0 0 0;">
            
            <Label text="Test yourself using your saved Question Bank." style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
            
            <HBox spacing="24" alignment="TOP_CENTER">
                <!-- Setup Form -->
                <VBox spacing="20" styleClass="card" minWidth="420" prefWidth="440" style="-fx-padding: 28;">
                    
                    <Label text="Configure Exam" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    
                    <VBox spacing="16">
                        <VBox spacing="6">
                            <Label text="Subject" styleClass="form-label"/>
                            <ComboBox fx:id="comboExamSubject" maxWidth="Infinity" styleClass="modern-combo"/>
                        </VBox>
                        
                        <VBox spacing="6">
                            <Label text="Topic" styleClass="form-label"/>
                            <ComboBox fx:id="comboExamTopic" maxWidth="Infinity" styleClass="modern-combo"/>
                        </VBox>
                        
                        <HBox spacing="16" minWidth="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Difficulty" styleClass="form-label"/>
                                <ComboBox fx:id="comboExamDifficulty" maxWidth="Infinity" styleClass="modern-combo"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Question Count" styleClass="form-label"/>
                                <ComboBox fx:id="comboExamCount" maxWidth="Infinity" styleClass="modern-combo"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="16" minWidth="0">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Mode" styleClass="form-label"/>
                                <ComboBox fx:id="comboExamMode" maxWidth="Infinity" styleClass="modern-combo"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Time Limit (min)" styleClass="form-label"/>
                                <ComboBox fx:id="comboExamTime" maxWidth="Infinity" styleClass="modern-combo"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="12" alignment="CENTER" style="-fx-padding: 16 0 0 0; -fx-border-color: #e2e8f0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                        <Label fx:id="lblAvailableBankCount" text="0 questions available" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        <Button fx:id="btnStartExam" text="Start Exam" onAction="#handleStartExam" maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                    </VBox>
                </VBox>
                
                <!-- Recent Attempts Sidebar -->
                <VBox fx:id="boxRecentAttempts" spacing="12" minWidth="280" maxWidth="280">
                    <Label text="Recent Attempts" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
                    <ListView fx:id="listRecentAttempts" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;"/>
                </VBox>
            </HBox>
            
        </VBox>
    </StackPane>

</VBox>
