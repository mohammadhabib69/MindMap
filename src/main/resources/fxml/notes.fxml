<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.NotesController"
      spacing="16"
      styleClass="screen-container">

    <padding>
        <Insets top="32" right="36" bottom="32" left="36"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Notes" styleClass="view-header"/>
            <Label text="Manage and organize your study material" styleClass="view-subtitle"/>
        </VBox>
        <Button fx:id="btnNewNote" text="+ New Note" onAction="#handleNewNote" styleClass="btn-primary"/>
    </HBox>

    <!-- Search, Filter & Actions Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearchNotes" promptText="Search notes by title, content, or subject..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <ComboBox fx:id="cmbTagFilter" promptText="All Tags" prefWidth="180" styleClass="input-field"/>
        <Button fx:id="btnClearFilter" text="Reset" onAction="#handleClearFilter" styleClass="btn-secondary"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnViewNote" text="View" onAction="#handleViewNote" disable="true" styleClass="btn-secondary"/>
            <Button fx:id="btnEditNote" text="Edit" onAction="#handleEditNote" disable="true" styleClass="btn-secondary"/>
            <Button fx:id="btnDeleteNote" text="Delete" onAction="#handleDeleteNote" disable="true" styleClass="btn-danger"/>
        </HBox>
    </HBox>

    <!-- Notes TableView -->
    <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colTitle" text="Title" prefWidth="280"/>
            <TableColumn fx:id="colSubject" text="Subject" prefWidth="150"/>
            <TableColumn fx:id="colDifficulty" text="Difficulty" prefWidth="100"/>
            <TableColumn fx:id="colTags" text="Tags" prefWidth="200"/>
            <TableColumn fx:id="colUpdated" text="Updated" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <VBox alignment="CENTER" spacing="8" styleClass="table-placeholder">
                <Label fx:id="lblPlaceholderTitle" text="No notes found" styleClass="placeholder-heading"/>
                <Label fx:id="lblPlaceholderSubtitle" text="Click '+ New Note' above to create your first note." styleClass="placeholder-subtext"/>
            </VBox>
        </placeholder>
    </TableView>

</VBox>
