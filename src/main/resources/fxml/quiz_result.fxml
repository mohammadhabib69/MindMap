<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizResultController"
      spacing="0" styleClass="screen-container"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label text="Exam Results" styleClass="view-header"/>
            <Label fx:id="lblMessage" text="Great job!" style="-fx-font-size: 15px; -fx-text-fill: #16a34a; -fx-font-weight: bold;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnBack" text="Back to Quiz Hub" onAction="#handleBack" styleClass="btn-secondary"/>
    </HBox>

    <Region prefHeight="24"/>

    <!-- Metrics Bar -->
    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="SCORE" styleClass="stat-label"/>
            <Label fx:id="lblScore" text="0 / 0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="PERCENTAGE" styleClass="stat-label"/>
            <Label fx:id="lblPercentage" text="0%" styleClass="stat-value"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="CORRECT" styleClass="stat-label" style="-fx-text-fill: #16a34a;"/>
            <Label fx:id="lblCorrect" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="INCORRECT" styleClass="stat-label" style="-fx-text-fill: #dc2626;"/>
            <Label fx:id="lblIncorrect" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="UNANSWERED" styleClass="stat-label" style="-fx-text-fill: #d97706;"/>
            <Label fx:id="lblUnanswered" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="dashboard-metric-card">
            <Label text="TIME USED" styleClass="stat-label"/>
            <Label fx:id="lblTimeUsed" text="00:00" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <Region prefHeight="24"/>
    
    <Label text="Question Review" styleClass="section-title"/>
    <Region prefHeight="12"/>

    <!-- Review List -->
    <ListView fx:id="listReview" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;"/>
    
</VBox>
