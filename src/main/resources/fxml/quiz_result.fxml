<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizResultController"
      spacing="20" styleClass="screen-container" style="-fx-background-color: #f8fafc; -fx-padding: 20;">

    <HBox alignment="CENTER_LEFT">
        <Label text="Exam Results" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnBack" text="Back to Quiz Hub" onAction="#handleBack" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 8 16; -fx-background-radius: 4; -fx-border-color: #e2e8f0; -fx-border-radius: 4;"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Score" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblScore" text="0 / 0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
        </VBox>
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Percentage" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblPercentage" text="0%" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Correct" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblCorrect" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
        </VBox>
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Incorrect" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblIncorrect" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
        </VBox>
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Unanswered" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblUnanswered" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
        </VBox>
        <VBox alignment="CENTER" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-background-radius: 8;">
            <Label text="Time Used" style="-fx-text-fill: #64748b;"/>
            <Label fx:id="lblTimeUsed" text="00:00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
    </HBox>

    <Label fx:id="lblMessage" text="Great job!" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #10b981; -fx-padding: 10 0 0 0;"/>

    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <Label text="Review Answers" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <ListView fx:id="listReview" VBox.vgrow="ALWAYS" style="-fx-background-insets: 0; -fx-background-color: transparent;"/>
    </VBox>

</VBox>
