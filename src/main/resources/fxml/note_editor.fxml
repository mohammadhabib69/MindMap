<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.NoteEditorController"
      spacing="16"
      prefWidth="560"
      prefHeight="580"
      styleClass="dialog-container"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- Dialog Header & Templates -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="lblDialogTitle" text="Create New Note" styleClass="dialog-title"/>
            <Label text="Fill in note details below. Fields marked * are required." styleClass="dialog-subtitle"/>
        </VBox>
        <ComboBox fx:id="cmbTemplate" promptText="Select Template" visible="false" managed="false" styleClass="input-field"/>
    </HBox>

    <!-- Title Field -->
    <VBox spacing="6">
        <Label text="Title *" styleClass="form-label"/>
        <TextField fx:id="txtTitle" promptText="e.g., Binary Search Tree Invariants" styleClass="input-field"/>
    </VBox>

    <!-- Subject & Difficulty HBox -->
    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Subject / Topic" styleClass="form-label"/>
            <TextField fx:id="txtSubject" promptText="e.g., Computer Science, Algorithms" styleClass="input-field"/>
        </VBox>
        <VBox spacing="6" prefWidth="160">
            <Label text="Difficulty" styleClass="form-label"/>
            <ComboBox fx:id="cmbDifficulty" maxWidth="Infinity" styleClass="input-field"/>
        </VBox>
    </HBox>

    <!-- Tags Field -->
    <VBox spacing="6">
        <Label text="Tags (comma-separated)" styleClass="form-label"/>
        <TextField fx:id="txtTags" promptText="e.g., BST, Tree, Algorithms" styleClass="input-field"/>
    </VBox>

    <!-- Content Field -->
    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Content" styleClass="form-label"/>
        <TextArea fx:id="txtContent" promptText="Enter study notes, key definitions, formulas, and explanations..." wrapText="true" VBox.vgrow="ALWAYS" styleClass="text-area-editor"/>
    </VBox>

    <!-- Private Note Section -->
    <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
        <javafx.scene.control.CheckBox fx:id="chkPrivate" text="🔒 Private Note (Requires PIN to view/edit)" style="-fx-font-weight: bold;"/>
        
        <VBox fx:id="boxPinFields" spacing="8" visible="false" managed="false">
            <Label text="Your PIN protects this note's private content." style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="PIN" styleClass="form-label"/>
                    <javafx.scene.control.PasswordField fx:id="txtPin" promptText="Enter PIN" styleClass="input-field"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Confirm PIN" styleClass="form-label"/>
                    <javafx.scene.control.PasswordField fx:id="txtConfirmPin" promptText="Confirm PIN" styleClass="input-field"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <!-- Error Message -->
    <Label fx:id="lblError" text="" styleClass="error-label" wrapText="true"/>

    <!-- Action Buttons -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <ToggleButton fx:id="btnFavorite" text="☆ Favorite" onAction="#handleToggleFavorite" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancel" text="Cancel" onAction="#handleCancel" cancelButton="true" styleClass="btn-secondary"/>
        <Button fx:id="btnSave" text="Save" onAction="#handleSave" defaultButton="true" styleClass="btn-primary"/>
    </HBox>

</VBox>
