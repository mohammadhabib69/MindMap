<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizSessionController"
      spacing="0" styleClass="screen-container"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="28" right="36" bottom="28" left="36"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label fx:id="lblSessionTitle" text="Exam" styleClass="view-header"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="lblProgress" text="Question 1 of 5" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ProgressBar fx:id="progressSession" prefWidth="220" progress="0.2" styleClass="dashboard-progress"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Timer (visible in Exam mode) -->
        <VBox alignment="CENTER_RIGHT">
            <Label fx:id="lblTimer" text="00:00" visible="false" managed="false" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
            <Button fx:id="btnExitStudy" text="Exit Study Mode" visible="false" managed="false" onAction="#handleExitStudy" styleClass="btn-secondary"/>
        </VBox>
    </HBox>

    <Region prefHeight="24"/>

    <!-- Main Question Area -->
    <HBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <VBox spacing="20" maxWidth="800" HBox.hgrow="ALWAYS">
            
            <!-- Question Card -->
            <VBox spacing="18" styleClass="card" style="-fx-padding: 32;">
                <Label fx:id="lblQuestionText" text="Question text here..." wrapText="true" style="-fx-font-size: 16px; -fx-text-fill: #172033; -fx-font-weight: 600;"/>
                
                <Separator style="-fx-padding: 6 0;"/>
                
                <!-- Options Container -->
                <VBox fx:id="boxOptions" spacing="10"/>
                
                <!-- Explanation (Study Mode Only) -->
                <VBox fx:id="boxExplanation" visible="false" managed="false" spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label fx:id="lblCorrectAnswer" text="Correct Answer:" style="-fx-font-weight: bold; -fx-text-fill: #16a34a; -fx-font-size: 14px;"/>
                    <Label fx:id="lblExplanation" text="Explanation text..." wrapText="true" style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-line-spacing: 2px;"/>
                    <Button fx:id="btnViewSourceNote" text="View Source Note" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10;"/>
                </VBox>
            </VBox>

            <!-- Navigation Controls -->
            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="btnShowAnswer" text="Show Answer" visible="false" managed="false" onAction="#handleShowAnswer" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="btnPrev" text="Previous" onAction="#handlePrev" styleClass="btn-secondary"/>
                
                <!-- Question Number Navigator -->
                <FlowPane fx:id="boxNavigator" hgap="6" vgap="6" alignment="CENTER" maxWidth="320"/>
                
                <Button fx:id="btnNext" text="Next" onAction="#handleNext" styleClass="btn-secondary"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSubmit" text="Submit Exam" onAction="#handleSubmit" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
