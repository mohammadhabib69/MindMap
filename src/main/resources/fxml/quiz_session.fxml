<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mindmap.controller.QuizSessionController"
      spacing="0" styleClass="screen-container" style="-fx-background-color: #f8fafc;">

    <padding>
        <Insets top="32" right="40" bottom="32" left="40"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label fx:id="lblSessionTitle" text="Exam" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblProgress" text="Question 1 of 5" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                <ProgressBar fx:id="progressSession" prefWidth="200" progress="0.2" style="-fx-accent: #4f46e5;"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Timer (visible in Exam mode) -->
        <VBox alignment="CENTER_RIGHT">
            <Label fx:id="lblTimer" text="00:00" visible="false" managed="false" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Button fx:id="btnExitStudy" text="Exit Study Mode" visible="false" managed="false" onAction="#handleExitStudy" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
        </VBox>
    </HBox>

    <Region prefHeight="30"/>

    <!-- Main Question Area -->
    <HBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <VBox spacing="24" maxWidth="800" HBox.hgrow="ALWAYS">
            
            <!-- Question Card -->
            <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.04), 8, 0.08, 0, 2);">
                <Label fx:id="lblQuestionText" text="Question text here..." wrapText="true" style="-fx-font-size: 18px; -fx-text-fill: #0f172a; -fx-font-weight: 500;"/>
                
                <Separator style="-fx-padding: 10 0;"/>
                
                <!-- Options Container -->
                <VBox fx:id="boxOptions" spacing="12"/>
                
                <!-- Explanation (Study Mode Only) -->
                <VBox fx:id="boxExplanation" visible="false" managed="false" spacing="12" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-margin: 20 0 0 0;">
                    <Label fx:id="lblCorrectAnswer" text="Correct Answer:" style="-fx-font-weight: bold; -fx-text-fill: #16a34a; -fx-font-size: 15px;"/>
                    <Label fx:id="lblExplanation" text="Explanation text..." wrapText="true" style="-fx-text-fill: #334155; -fx-font-size: 14px; -fx-font-style: italic;"/>
                    <Button fx:id="btnViewSourceNote" text="View Source Note" style="-fx-background-color: #e0e7ff; -fx-text-fill: #3730a3; -fx-padding: 6 12; -fx-background-radius: 4; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>

            <!-- Navigation Controls -->
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="btnShowAnswer" text="Show Answer" visible="false" managed="false" onAction="#handleShowAnswer" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="btnPrev" text="← Previous" onAction="#handlePrev" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                
                <!-- Question Number Navigator -->
                <FlowPane fx:id="boxNavigator" hgap="8" vgap="8" alignment="CENTER" maxWidth="300"/>
                
                <Button fx:id="btnNext" text="Next →" onAction="#handleNext" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSubmit" text="Submit Exam" onAction="#handleSubmit" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 24; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
